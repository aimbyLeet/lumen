<!-- Windows Sandbox: Lumen Client updating itself from its server.
     Before: tools\installer-sandbox\build-client-update.ps1. The report: bench-out\sandbox\results\client-update.txt. -->
<Configuration>
  <Networking>Enable</Networking>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>C:\dev\lumen\tools\installer-sandbox</HostFolder>
      <SandboxFolder>C:\LumenTests</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>C:\dev\lumen\bench-out\sandbox</HostFolder>
      <SandboxFolder>C:\LumenOut</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>powershell.exe -NoExit -ExecutionPolicy Bypass -File C:\LumenTests\run-client-update.ps1</Command>
  </LogonCommand>
</Configuration>
