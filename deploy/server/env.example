# Lumen server settings of the domain mode, for reference: install.sh writes /opt/lumen-server/.env
# itself (the user manual, manual/manual_EN.html: "What lives where on the server").
# Write values without "$": docker compose takes it for a variable.

# Domain of the server; its DNS A record points to this VPS. Hosts and clients
# are set up with it (not the IP): the certificate is issued for it.
LUMEN_DOMAIN=lumen.example.com

# Certificate name in certbot (/etc/letsencrypt/live/<name>), if not the domain
# (`certbot certificates` shows it, e.g. lumen.example.com-0001).
LUMEN_CERT_NAME=

# Signaling port (TCP, TLS) for hosts and clients: open it in the firewall.
LUMEN_SIGNAL_PORT=7443

# Web admin: plain HTTP on 127.0.0.1:<port> for nginx (proxy_pass), not open outside.
LUMEN_ADMIN_PORT=7480
LUMEN_ADMIN_USER=admin
# At least 8 characters.
LUMEN_ADMIN_PASSWORD=
